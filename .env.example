# Copy this file to .env.local to configure the dashboard.
#
# Leave MODEL_API_URL empty to use the built-in sample data (mock API routes).
# Set it to your Python FastAPI server to use the real models, for example:
#   MODEL_API_URL=http://localhost:8000
# The dashboard will then call ${MODEL_API_URL}/emotion and ${MODEL_API_URL}/tts.
MODEL_API_URL=
