# Copy this file to .env.local to configure the dashboard.
#
# Each model has its own backend URL:
#   EMOTION_API_URL  IndicBERT, REQUIRED. The dashboard calls ${EMOTION_API_URL}/emotion.
#                    There is no sample data for IndicBERT: if this is empty, the IndicBERT stage shows an error.
#   TTS_API_URL      VITS. The dashboard calls ${TTS_API_URL}/tts. Leave empty to use sample voice data.
# Both may point to the same server, for example:
#   EMOTION_API_URL=http://localhost:8000
#   TTS_API_URL=http://localhost:8000
#
# A backend on a server needs its secret token (sent as "Authorization: Bearer <token>"). Leave empty locally.
#   EMOTION_API_URL=https://indic-bert.fot-research.tech
#   EMOTION_API_TOKEN=<the API_TOKEN from /opt/indic-bert/.env on the VPS>
EMOTION_API_URL=
EMOTION_API_TOKEN=
TTS_API_URL=
TTS_API_TOKEN=
